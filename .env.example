# ------------------------------------------------------------------
# ART RÉNOV 56 — variables d'environnement
# Copier en .env.local (jamais commité). Aucune vraie valeur ici.
# ------------------------------------------------------------------

# URL publique du site (sans slash final) — canonical, sitemap, Open Graph
NEXT_PUBLIC_SITE_URL=https://www.artrenov56.fr

# true sur une préproduction : robots.txt bloque tout + meta noindex
SITE_NOINDEX=false

# ------------------------------------------------------------------
# Formulaire de contact (étape Contact — après confirmation de l'offre Hostinger)
# Secrets uniquement côté serveur : ne jamais les préfixer par NEXT_PUBLIC_.
# ------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
